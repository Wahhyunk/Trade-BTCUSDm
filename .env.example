# ====================================================================
# Salin file ini menjadi ".env", lalu sesuaikan dengan broker MT5 kamu.
# ====================================================================

# --- MetaTrader 5 ---
MT5_SYMBOL=BTCUSDm
MT5_TIMEFRAME=M1
POLL_SECONDS=5
MT5_MAGIC=202611
MT5_DEVIATION=500
MT5_MAX_SPREAD=0
# MT5_FIXED_LOT=0 -> hitung otomatis dari RISK_PER_TRADE. Isi misal 0.01 untuk lot tetap.
MT5_FIXED_LOT=0.01
MT5_ALLOW_MIN_LOT=true
# Kosongkan agar otomatis tersambung ke terminal MT5 yang sedang terbuka.
MT5_PATH=

# --- Strategi (scalp | donchian | ema_cross) ---
STRATEGY=scalp
TP_PCT=0.015
SL_PCT=0.005
COOLDOWN_BARS=5
MAX_HOLD_BARS=0

# --- Risk Guard ---
GUARD_ENABLED=true
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS_PCT=0.05
MAX_TRADES_PER_DAY=10
MAX_CONSECUTIVE_LOSSES=4
PAUSE_MINUTES=60
MAX_DRAWDOWN_PCT=0.15
MIN_REWARD_RISK=1.5
MAX_LEVERAGE=10
MAX_PRICE_AGE_SEC=150
