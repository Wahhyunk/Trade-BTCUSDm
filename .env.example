# ====================================================================
# Salin file ini menjadi ".env", lalu sesuaikan dengan broker MT5 kamu.
# ====================================================================

# --- MetaTrader 5 ---
MT5_SYMBOL=BTCUSDm
MT5_TIMEFRAME=M30
POLL_SECONDS=5
MT5_MAGIC=202611
MT5_DEVIATION=500
MT5_MAX_SPREAD=2500
# MT5_FIXED_LOT=0 -> hitung otomatis dari RISK_PER_TRADE. Isi misal 0.01 untuk lot tetap.
MT5_FIXED_LOT=0.01
MT5_ALLOW_MIN_LOT=true
# Kosongkan agar otomatis tersambung ke terminal MT5 yang sedang terbuka.
MT5_PATH=

# --- Strategi (mtf_pullback | mtf_combo | session_box | scalp | donchian | ema_cross) ---
STRATEGY=mtf_pullback
ATR_PERIOD=14
ATR_SL_MULT=1.5
ATR_TP_MULT=3.0
BE_TRIGGER_R=1.0
TRAIL_ATR_MULT=0.0
ADX_MIN=18.0
RSI_PULLBACK=45.0
BOX_START_HOUR=5
BOX_END_HOUR=8
BOX_TRADE_END_HOUR=16
BOX_VOL_MULT=1.1
BOX_TP_MULT=2.5
MAX_ATR_PCT=0.0
# Fallback SL/TP (%) untuk strategi legacy (scalp | donchian | ema_cross)
TP_PCT=0.015
SL_PCT=0.005
COOLDOWN_BARS=2
MAX_HOLD_BARS=0

# --- Risk Guard ---
GUARD_ENABLED=true
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS_PCT=0.05
MAX_TRADES_PER_DAY=10
MAX_CONSECUTIVE_LOSSES=4
PAUSE_MINUTES=60
MAX_DRAWDOWN_PCT=0.15
MIN_REWARD_RISK=1.5
MAX_LEVERAGE=10
MAX_PRICE_AGE_SEC=150
